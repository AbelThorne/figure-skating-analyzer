# Copier en `.env` sur le VPS (dans /opt/stacks/proxy/) et renseigner.
# Ce fichier est lu par docker-compose et injecté dans le Caddyfile.

# Contact ACME : Let's Encrypt y envoie les avis d'expiration.
TLS_EMAIL=admin@exemple.fr

# Domaines des applications. Chacun DOIT avoir un enregistrement DNS A
# pointant vers l'IP du VPS AVANT le premier démarrage : sans cela, le
# challenge HTTP-01 échoue et aucun certificat n'est émis.
LIGUE_DOMAIN=competitions.exemple.fr

# SkateLab est encore servi par GCP : son bloc est commenté dans le
# Caddyfile (pas encore déployé sur ce VPS). Cette variable est donc
# inutilisée pour l'instant — conservée pour la bascule GCP → VPS, quand
# le bloc sera décommenté.
SKATELAB_DOMAIN=skatelab.exemple.fr
